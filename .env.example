PORT=3000
GOOGLE_CLIENT_ID=tu_cliente_google.apps.googleusercontent.com
APP_SESSION_SECRET=cambia-por-un-secreto-largo-y-aleatorio
PASSWORD_HASH_PEPPER=cambia-por-un-pepper-largo-y-aleatorio

# Bootstrap temporal e idempotente. Desactivar despues de crear la cuenta.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# auto = usa Supabase si detecta variables, local si no existen
# supabase = fuerza almacenamiento remoto
# local = fuerza JSON local
STORAGE_DRIVER=auto

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_TABLE=survey_submissions
