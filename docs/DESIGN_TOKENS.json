      "warning": {
        "text": "#92400E",
        "bg": "#FFFBEB",
        "border": "#FDE68A",
        "solid": "#F59E0B"
      },
      "danger": {
        "text": "#991B1B",
        "bg": "#FEF2F2",
        "border": "#FECACA",
        "solid": "#EF4444"
      },
      "info": {
        "text": "#1E40AF",
        "bg": "#EFF6FF",
        "border": "#BFDBFE",
        "solid": "#3B82F6"
      }
    },
    "charts": {
      "userPolygon": "#2563EB",
      "userPolygonFill": "rgba(37, 99, 235, 0.18)",
      "trendLine": "#3B82F6",
      "trendGradientStart": "rgba(59, 130, 246, 0.25)",
      "trendGradientEnd": "rgba(59, 130, 246, 0.00)",
      "gaugeTrack": "#E2E8F0",
      "gaugeArcPrimary": "#2563EB",
      "gaugeArcAccent": "#F59E0B"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "heading": "'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.65
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "borderRadius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "pill": "9999px"
  },
  "shadows": {
    "card": "0 2px 8px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.02)",
    "cardHover": "0 12px 24px -4px rgba(15, 23, 42, 0.08), 0 4px 6px -2px rgba(15, 23, 42, 0.03)",
    "elevated": "0 20px 32px -8px rgba(11, 25, 44, 0.12)",
    "subtle": "0 1px 3px rgba(0, 0, 0, 0.05)"
  },
  "transitions": {
    "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
    "default": "250ms cubic-bezier(0.4, 0, 0.2, 1)",
    "smooth": "350ms cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
