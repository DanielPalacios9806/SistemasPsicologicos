{
  "name": "Mente de Acero Design Tokens",
  "version": "2.1.0",
  "theme": "humanized-wellness-platform",
  "brand": {
    "name": "Mente de Acero",
    "tagline": "Conócete mejor. Entrena tu mente. Fortalece tu vida.",
    "values": [
      "Fortaleza",
      "Autoconocimiento",
      "Confidencialidad",
      "Bienestar",
      "Progreso"
    ]
  },
  "colors": {
    "brand": {
      "navy": "#0B192C",
      "navySurface": "#132338",
      "navyBorder": "#1E3550",
      "gold": "#D99B26",
      "goldSoft": "#FFF7E6",
      "goldHover": "#B88018",
      "teal": "#0B716C",
      "tealSoft": "#E6F5F4",
      "tealDark": "#075551"
    },
    "surface": {
      "canvas": "#F4F7F9",
      "card": "#FFFFFF",
      "cardSoft": "#F8FAFC",
      "cardHover": "#F1F5F9",
      "border": "#E2E8F0",
      "borderSubtle": "#EDF2F7",
      "divider": "#CBD5E1"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "subtle": "#94A3B8",
      "inverse": "#FFFFFF",
      "goldInk": "#92400E"
    },
    "feedback": {
      "success": {
        "text": "#065F46",
        "bg": "#ECFDF5",
        "border": "#A7F3D0",
        "solid": "#10B981"
